<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      NETWORK ENCRYPTION. `usesCleartextTraffic="false"` on the application
      below states outright that nothing may leave this app unencrypted.

      It is already the platform default at targetSdk 28 and above, so this
      changes no behaviour today. It is declared anyway for two reasons. It is
      the difference between "encrypted in transit" being an inherited default
      and being a property of this app that can be read out of the built
      artifact and checked: which is what Play's Data Safety form is asking
      about. And a dependency that ever permits cleartext would otherwise win
      the manifest merge silently; with this declared here the merge fails
      instead, and somebody has to decide deliberately rather than finding out
      from a policy email. No `tools:replace` for the same reason: quietly
      overriding such a library is the outcome worth avoiding.

      (The literal attribute is deliberately not spelled out in this comment.
      The merger copies comments into the merged manifest, so writing it here
      made a grep for it report a cleartext declaration that did not exist.)

      The app itself opens no connections at all. Every byte that leaves the
      device goes through a Google SDK (Play Games Services for cloud save,
      Play Billing for purchases, Mobile Ads and UMP for advertising and
      consent) and each of those is TLS to Google. There is no HTTP client,
      no socket and no URL in this codebase.

      PERMISSION AUDIT. Four are declared here and every one has a caller; the
      rest of what ends up in the merged manifest comes from the Play SDKs and
      is inventoried in PRIVACY_AND_DATA_SAFETY.md.

      The game itself is entirely offline: every asset is generated at runtime
      and no gameplay feature needs a network. A build with no Play ids
      configured never opens a connection at all: it selects the no-op
      gateways and behaves exactly as the offline build did.
    -->

    <!-- Haptics. Used by HapticEngine, and switchable off in settings. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Billing, AdMob and the consent form. Nothing in gameplay uses it. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required by the Mobile Ads SDK to avoid requesting with no network. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      THE ADVERTISING ID IS REMOVED, ON PURPOSE.

      The Mobile Ads SDK declares this permission in its own manifest, so it
      arrives by dependency merge rather than by anyone asking for it. It is
      stripped back out here.

      The reason is the audience. This game is played by children, it collects
      no age and has no age gate, so every ad request carries child-directed
      treatment (see AdPrivacy.kt). A child-directed request must not carry a
      resettable advertising identifier, and the most reliable way to be sure
      one is never read is to withhold the permission that allows reading it:
      a runtime configuration can be got wrong by a future edit, an absent
      permission cannot.

      This also makes the Play Data Safety answer a fact about the artifact
      rather than a promise about the code. A merged manifest with no AD_ID in
      it is checkable, and tools/verify-release.sh checks it.

      tools:node="remove" is required: without it the SDK's declaration simply
      merges in and wins, because nothing here would contradict it.
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.CyOpsTD">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/games_app_id" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|navigation"
            android:launchMode="singleTask"
            android:theme="@style/Theme.CyOpsTD">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
