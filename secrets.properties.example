# Copy to `secrets.properties` (same directory) and fill in.
#
# `secrets.properties` is git-ignored. This example file is not, and must never
# contain a real id, password or path.
#
# Every value here can also be supplied as a Gradle property
# (-Pcyops.admob.appId=…, or ~/.gradle/gradle.properties) or as an environment
# variable with the name upper-cased and dotted-to-underscored
# (CYOPS_ADMOB_APPID, CYOPS_KEYSTORE_PASSWORD, …), which is what CI uses.

# --- AdMob -------------------------------------------------------------------
# The APPLICATION id has a tilde. The AD UNIT ids have a slash. See
# ADMOB_SETUP.md; mixing them up is the classic mistake and fails at runtime
# with a message that does not say so.
#
# These reach RELEASE builds only. Debug builds always use Google's published
# test units and ignore everything here.

#cyops.admob.appId=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
#cyops.admob.rewardedId=ca-app-pub-XXXXXXXXXXXXXXXX/WWWWWWWWWW
#cyops.admob.interstitialId=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ

# --- Play upload key ---------------------------------------------------------
# All four or none. With none, a release build still succeeds and produces an
# UNSIGNED bundle, which cannot be uploaded. See PLAY_STORE_RELEASE.md.

#cyops.keystore.path=/absolute/path/to/cyopstd-upload.jks
#cyops.keystore.password=
#cyops.key.alias=cyopstd-upload
#cyops.key.password=

# --- Play Games Services (optional cloud save) -------------------------------
# The numeric project id. Leave unset to ship with on-device saves only.

#cyops.games.appId=1234567890

# Global leaderboards, one per game mode: the "CgkI..." id Play Console shows
# for each leaderboard. Need cyops.games.appId. Leave unset for local only.

#cyops.games.leaderboard.standard=CgkIxxxxxxxxxxxxEAIQAQ
#cyops.games.leaderboard.hack_ai=CgkIxxxxxxxxxxxxEAIQAg
